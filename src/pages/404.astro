---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — not found" description="Page not found.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-[var(--color-muted)]">
      <span class="text-[var(--color-ioc)]">$</span> cat /var/www/{Astro.url.pathname}
    </p>
    <h1 class="mt-4 font-mono text-5xl font-bold text-[var(--color-text-strong)]">404</h1>
    <p class="mt-4 text-[var(--color-text)]">No such file or directory — the page you wanted isn&apos;t here.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-semibold text-[var(--color-bg)] hover:bg-[var(--color-accent-strong)]">
        ← back home
      </a>
      <a href="/writeups" class="rounded-md border border-[var(--color-border-strong)] px-4 py-2 font-mono text-sm text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
        browse writeups
      </a>
    </div>
  </section>
</BaseLayout>
