---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
const c = profile.contact;
---

<BaseLayout title="Contact" description="Get in touch — email, WhatsApp, LinkedIn, or GitHub.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <header class="mb-10">
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-teal)]">
        <span class="status-dot mr-2"></span> reachable
      </p>
      <h1 class="mt-3 font-mono text-3xl font-bold text-[var(--color-text-strong)] sm:text-4xl">
        <span class="text-[var(--color-teal)]">#</span> contact
      </h1>
      <p class="mt-3 text-[var(--color-text)]">
        Reach out about pentest / red-team roles, offensive research collabs, CTF teams, or just to say hello.
      </p>
    </header>

    <!-- Primary action buttons -->
    <div class="grid gap-4 sm:grid-cols-2">
      <a
        href={`mailto:${c.email}?subject=Hello%20from%20your%20portfolio`}
        class="group flex min-h-[5rem] items-center gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4 transition-all hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:shadow-lg"
      >
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-[var(--color-bg-elev)] text-[var(--color-accent)] group-hover:bg-[var(--color-accent)] group-hover:text-[var(--color-bg)]">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-muted)]">email</p>
          <p class="mt-0.5 truncate font-mono text-sm text-[var(--color-text-strong)] group-hover:text-[var(--color-accent)]">{c.email}</p>
        </div>
      </a>

      <a
        href={c.whatsapp.url}
        target="_blank"
        rel="noopener"
        class="group flex min-h-[5rem] items-center gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4 transition-all hover:-translate-y-0.5 hover:border-[var(--color-teal)] hover:shadow-lg"
      >
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-[var(--color-bg-elev)] text-[var(--color-teal)] group-hover:bg-[var(--color-teal)] group-hover:text-[var(--color-bg)]">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
            <path d="M20.52 3.48A11.86 11.86 0 0012.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.16 1.6 5.97L0 24l6.27-1.64a11.9 11.9 0 005.77 1.47h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.17-3.45-8.43zM12.04 21.8h-.01a9.86 9.86 0 01-5.03-1.38l-.36-.21-3.72.97 1-3.63-.24-.37a9.84 9.84 0 01-1.52-5.26c0-5.45 4.43-9.88 9.89-9.88a9.83 9.83 0 016.99 2.9 9.83 9.83 0 012.9 6.99c0 5.45-4.44 9.87-9.9 9.87zm5.41-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.21 3.09.15.2 2.1 3.21 5.09 4.5.71.31 1.27.5 1.7.64.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-muted)]">whatsapp</p>
          <p class="mt-0.5 font-mono text-sm text-[var(--color-text-strong)] group-hover:text-[var(--color-teal)]">{c.whatsapp.display}</p>
        </div>
      </a>
    </div>

    <!-- Secondary links -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <a
        href={c.linkedin}
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-3 transition-colors hover:border-[var(--color-accent)]"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-[var(--color-muted)] group-hover:text-[var(--color-accent)]" fill="currentColor">
          <path d="M19 0h-14C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM8 19H5V8h3v11zM6.5 6.73a1.75 1.75 0 110-3.5 1.75 1.75 0 010 3.5zM20 19h-3v-5.6c0-1.33-.03-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95V19h-3V8h2.88v1.5h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6V19z"/>
        </svg>
        <span class="font-mono text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)]">linkedin.com/in/0xsh3ru</span>
      </a>
      <a
        href={c.github}
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-3 transition-colors hover:border-[var(--color-accent)]"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-[var(--color-muted)] group-hover:text-[var(--color-accent)]" fill="currentColor">
          <path d="M12 .3a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 016 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .3"/>
        </svg>
        <span class="font-mono text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)]">github.com/0xSh3ru</span>
      </a>
      <a
        href={c.tryhackme}
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-3 transition-colors hover:border-[var(--color-teal)] sm:col-span-2"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-[var(--color-muted)] group-hover:text-[var(--color-teal)]" fill="currentColor">
          <path d="M12 2L2 7l10 5 10-5-10-5zm0 7.5L4.5 6 12 2.7 19.5 6 12 9.5zM2 12.5l10 5 10-5v-2.7l-10 5-10-5v2.7zm0 5l10 5 10-5v-2.7l-10 5-10-5v2.7z"/>
        </svg>
        <span class="font-mono text-sm text-[var(--color-text)] group-hover:text-[var(--color-teal)]">tryhackme.com/p/researchersheru</span>
        <span class="ml-auto rounded bg-[var(--color-bg-elev)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--color-teal)]">CTF profile</span>
      </a>
    </div>

    <!-- Resume download -->
    <div class="mt-10 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
      <p class="font-mono text-sm text-[var(--color-text-strong)]">📄 Want the short version?</p>
      <p class="mt-1 text-sm text-[var(--color-muted)]">Download my resume as PDF, or read it on the site.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/ResumeHimangshuPan.pdf"
          download
          class="rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-semibold text-[var(--color-bg)] hover:bg-[var(--color-accent-strong)]"
        >
          ↓ save resume as PDF
        </a>
        <a
          href="/resume"
          class="rounded-md border border-[var(--color-border-strong)] px-4 py-2 font-mono text-sm text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          view resume →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
