---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalPrompt from "../components/TerminalPrompt.astro";
import SkillBadge from "../components/SkillBadge.astro";
import CertCard from "../components/CertCard.astro";
import WriteupCard from "../components/WriteupCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { profile } from "../data/profile";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroImage from "../assets/himangshupansocanalyst.png";

const writeups = (await getCollection("writeups", (e) => !e.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
const projects = (await getCollection("projects", (e) => !e.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-[var(--color-border)] bg-grid">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <div class="grid items-center gap-10 md:grid-cols-[1.2fr_1fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-teal)]">
            <span class="status-dot mr-2"></span> status: monitoring
          </p>
          <h1 class="mt-4 font-mono text-3xl font-bold leading-tight text-[var(--color-text-strong)] sm:text-4xl md:text-5xl">
            Hi, I&apos;m <span class="text-[var(--color-accent)]">{profile.name}</span>.
          </h1>
          <p class="mt-4 max-w-xl text-base text-[var(--color-text)] sm:text-lg">
            {profile.tagline}. I investigate logs, build detections, and write up what I learn so others can use it.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/writeups" class="rounded-md bg-[var(--color-accent)] px-4 py-2.5 font-mono text-sm font-semibold text-[var(--color-bg)] transition-colors hover:bg-[var(--color-accent-strong)]">
              read writeups →
            </a>
            <a href="/contact" class="rounded-md border border-[var(--color-border-strong)] px-4 py-2.5 font-mono text-sm text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">
              get in touch
            </a>
            <a href="/resume" class="rounded-md border border-[var(--color-border-strong)] px-4 py-2.5 font-mono text-sm text-[var(--color-text)] transition-colors hover:border-[var(--color-teal)] hover:text-[var(--color-teal)]">
              view resume
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-2 rounded-xl bg-gradient-to-br from-[var(--color-accent)]/20 via-transparent to-[var(--color-teal)]/20 blur-2xl"></div>
          <div class="relative overflow-hidden rounded-xl border border-[var(--color-border-strong)] bg-[var(--color-bg-card)] shadow-2xl">
            <Image
              src={heroImage}
              alt="Himangshu Pan at a SOC analyst workstation surrounded by dashboards, detection alerts, and the motto: detect · analyze · respond"
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 768px) 100vw, 50vw"
              quality={85}
              class="h-auto w-full"
              loading="eager"
            />
          </div>
          <p class="mt-3 text-center font-mono text-xs text-[var(--color-muted)]">
            <span class="text-[var(--color-teal)]">$</span> work in silence — let your detections make the noise
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Terminal "whoami" strip -->
  <section class="border-b border-[var(--color-border)] bg-[var(--color-bg-elev)]">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
      <TerminalPrompt
        command="whoami --verbose"
        output={`himangshu.pan\nrole: SOC analyst (blue team)\nfocus: detection · IR · log analysis\nstatus: open to opportunities`}
      />
    </div>
  </section>

  <!-- ABOUT -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 class="font-mono text-xl font-semibold text-[var(--color-text-strong)]">
      <span class="text-[var(--color-teal)]">#</span> about
    </h2>
    <div class="mt-5 max-w-3xl space-y-4 text-[var(--color-text)]">
      {profile.bio.map((p) => (
        <p set:html={p.replace(/\*\*(.+?)\*\*/g, '<strong class="text-[var(--color-text-strong)]">$1</strong>')} />
      ))}
    </div>
  </section>

  <!-- SKILLS -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 class="font-mono text-xl font-semibold text-[var(--color-text-strong)]">
      <span class="text-[var(--color-teal)]">#</span> skills
    </h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {profile.skills.map((group) => (
        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4">
          <h3 class="font-mono text-sm text-[var(--color-accent)]">{group.group}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((item) => <SkillBadge label={item} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 class="font-mono text-xl font-semibold text-[var(--color-text-strong)]">
      <span class="text-[var(--color-teal)]">#</span> certifications
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {profile.certifications.map((c) => (
        <CertCard name={c.name} issuer={c.issuer} year={c.year} url={c.url || undefined} />
      ))}
    </div>
    <p class="mt-4 font-mono text-xs text-[var(--color-muted)]">
      <span class="text-[var(--color-teal)]">$</span> more in progress — BTL1, Security+, KC7.
    </p>
  </section>

  <!-- LATEST WRITEUPS -->
  {writeups.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-mono text-xl font-semibold text-[var(--color-text-strong)]">
          <span class="text-[var(--color-teal)]">#</span> recent writeups
        </h2>
        <a href="/writeups" class="font-mono text-sm text-[var(--color-accent)] hover:underline">all writeups →</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {writeups.map((w) => (
          <WriteupCard
            href={`/writeups/${w.id}/`}
            title={w.data.title}
            description={w.data.description}
            date={w.data.date}
            platform={w.data.platform}
            difficulty={w.data.difficulty}
            tags={w.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <!-- FEATURED PROJECTS -->
  {projects.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-mono text-xl font-semibold text-[var(--color-text-strong)]">
          <span class="text-[var(--color-teal)]">#</span> projects
        </h2>
        <a href="/projects" class="font-mono text-sm text-[var(--color-accent)] hover:underline">all projects →</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard
            href={`/projects/${p.id}/`}
            title={p.data.title}
            description={p.data.description}
            stack={p.data.stack}
            repo={p.data.repo || undefined}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
