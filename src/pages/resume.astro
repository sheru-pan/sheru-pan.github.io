---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout title="Resume" description={`Resume of ${profile.name} — ${profile.role}`}>
  <!-- Toolbar -->
  <div id="resume-toolbar" class="border-b border-[var(--color-border)] bg-[var(--color-bg)]">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
      <p class="font-mono text-xs text-[var(--color-muted)]">
        <span class="text-[var(--color-teal)]">$</span> cat resume.pdf
      </p>
      <div class="flex flex-wrap gap-2">
        <a
          href="/ResumeHimangshuPan.pdf"
          download
          class="rounded-md bg-[var(--color-accent)] px-3 py-1.5 font-mono text-xs font-semibold text-[var(--color-bg)] hover:bg-[var(--color-accent-strong)]"
        >
          ↓ download PDF
        </a>
        <a
          href={profile.contact.linkedin}
          target="_blank"
          rel="noopener"
          class="rounded-md border border-[var(--color-border-strong)] px-3 py-1.5 font-mono text-xs text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          view on linkedin →
        </a>
      </div>
    </div>
  </div>

  <!-- PDF viewer — fills remaining viewport height -->
  <div id="resume-viewer" class="mx-auto max-w-4xl px-4 py-6 sm:px-6">
    <iframe
      id="resume-iframe"
      src="/ResumeHimangshuPan.pdf#view=FitH&toolbar=0"
      title="Himangshu Pan — Resume"
      class="w-full rounded-lg border border-[var(--color-border-strong)]"
      style="height: calc(100dvh - 160px); min-height: 500px;"
      loading="eager"
    >
      <!-- Fallback for browsers that block iframes -->
      <div class="flex flex-col items-center justify-center gap-4 p-12 text-center">
        <p class="text-[var(--color-text)]">Your browser cannot display the PDF inline.</p>
        <a
          href="/ResumeHimangshuPan.pdf"
          download
          class="rounded-md bg-[var(--color-accent)] px-4 py-2 font-mono text-sm font-semibold text-[var(--color-bg)] hover:bg-[var(--color-accent-strong)]"
        >
          ↓ download PDF
        </a>
      </div>
    </iframe>
  </div>
</BaseLayout>

<script>
  // Measure actual nav + toolbar height so the iframe fills exactly the remaining space.
  function fitViewer() {
    const nav = document.querySelector("header");
    const toolbar = document.getElementById("resume-toolbar");
    const iframe = document.getElementById("resume-iframe") as HTMLIFrameElement | null;
    if (!iframe) return;
    const navH = nav?.getBoundingClientRect().height ?? 48;
    const toolbarH = toolbar?.getBoundingClientRect().height ?? 44;
    const remaining = window.innerHeight - navH - toolbarH;
    iframe.style.height = `${Math.max(remaining, 500)}px`;
  }

  fitViewer();
  window.addEventListener("resize", fitViewer);
</script>
