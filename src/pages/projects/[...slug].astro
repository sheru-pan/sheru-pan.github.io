---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AllPostsSidebar from "../../components/AllPostsSidebar.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("projects", (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatted = entry.data.date.toISOString().slice(0, 10);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="mb-6 font-mono text-xs">
      <a href="/projects" class="text-[var(--color-muted)] hover:text-[var(--color-accent)]">← all projects</a>
    </p>

    <header class="mb-10 border-b border-[var(--color-border)] pb-6">
      <p class="font-mono text-xs text-[var(--color-muted)]">{formatted}</p>
      <h1 class="mt-2 font-mono text-3xl font-bold leading-tight text-[var(--color-text-strong)] sm:text-4xl">{entry.data.title}</h1>
      <p class="mt-3 max-w-3xl text-[var(--color-text)]">{entry.data.description}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {entry.data.stack.map((s: string) => (
          <span class="rounded bg-[var(--color-bg-card)] px-2 py-0.5 font-mono text-xs text-[var(--color-teal)]">{s}</span>
        ))}
        {entry.data.repo && (
          <a
            href={entry.data.repo}
            target="_blank"
            rel="noopener"
            class="rounded border border-[var(--color-border-strong)] px-2 py-0.5 font-mono text-xs text-[var(--color-accent)] hover:border-[var(--color-accent)]"
          >
            ↗ repo
          </a>
        )}
      </div>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1fr_18rem]">
      <div class="prose-blue min-w-0">
        <Content />
      </div>
      <div class="lg:sticky lg:top-20 lg:self-start">
        <details class="lg:hidden">
          <summary class="cursor-pointer rounded border border-[var(--color-border)] bg-[var(--color-bg-card)] px-3 py-2 font-mono text-sm text-[var(--color-accent)]">
            other projects ↓
          </summary>
          <div class="mt-3">
            <AllPostsSidebar collection="projects" currentId={entry.id} />
          </div>
        </details>
        <div class="hidden lg:block">
          <AllPostsSidebar collection="projects" currentId={entry.id} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
