---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", (e) => !e.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout title="Projects" description="Hands-on security lab setups, practice environments, and tools built while learning cybersecurity.">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-teal)]">
        <span class="status-dot mr-2"></span> {projects.length} project{projects.length === 1 ? "" : "s"}
      </p>
      <h1 class="mt-3 font-mono text-3xl font-bold text-[var(--color-text-strong)]">
        <span class="text-[var(--color-teal)]">#</span> projects
      </h1>
      <p class="mt-3 max-w-2xl text-[var(--color-text)]">
        Hands-on lab setups, practice environments, and tools built while learning and exploring cybersecurity.
      </p>
    </header>

    {projects.length === 0 ? (
      <p class="font-mono text-sm text-[var(--color-muted)]">no projects published yet — check back soon.</p>
    ) : (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard
            href={`/projects/${p.id}/`}
            title={p.data.title}
            description={p.data.description}
            stack={p.data.stack}
            repo={p.data.repo || undefined}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
