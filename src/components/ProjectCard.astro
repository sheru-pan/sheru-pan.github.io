---
interface Props {
  href: string;
  title: string;
  description: string;
  stack?: readonly string[];
  repo?: string;
}
const { href, title, description, stack = [], repo } = Astro.props;
---

<a
  href={href}
  class="group block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 transition-all hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:shadow-lg"
>
  <h3 class="font-mono text-lg font-semibold text-[var(--color-text-strong)] group-hover:text-[var(--color-accent)]">{title}</h3>
  <p class="mt-2 text-sm text-[var(--color-text)]">{description}</p>
  {stack.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {stack.map((s) => (
        <span class="rounded bg-[var(--color-bg-elev)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--color-teal)]">{s}</span>
      ))}
    </div>
  )}
  {repo && (
    <p class="mt-3 font-mono text-xs text-[var(--color-muted)]">
      <span class="text-[var(--color-teal)]">↗</span> repo
    </p>
  )}
</a>
