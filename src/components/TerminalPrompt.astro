---
interface Props {
  user?: string;
  host?: string;
  path?: string;
  command: string;
  output?: string;
}
const { user = "sheru", host = "soc", path = "~", command, output } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] font-mono text-sm shadow-lg">
  <div class="flex items-center gap-1.5 border-b border-[var(--color-border)] bg-[var(--color-bg-elev)] px-3 py-1.5">
    <span class="h-2.5 w-2.5 rounded-full bg-[#f07178]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#f0c674]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#7fd1b9]"></span>
    <span class="ml-2 text-xs text-[var(--color-muted)]">{user}@{host}:{path}</span>
  </div>
  <div class="px-4 py-3 leading-relaxed">
    <div>
      <span class="text-[var(--color-teal)]">{user}@{host}</span><span class="text-[var(--color-muted)]">:</span><span class="text-[var(--color-accent)]">{path}</span><span class="text-[var(--color-muted)]">$</span>
      <span class="text-[var(--color-text-strong)]"> {command}</span>
    </div>
    {output && <pre class="mt-1 whitespace-pre-wrap text-[var(--color-text)]">{output}</pre>}
  </div>
</div>
