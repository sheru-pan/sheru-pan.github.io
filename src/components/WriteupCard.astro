---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  platform?: string;
  difficulty?: string;
  tags?: readonly string[];
}
const { href, title, description, date, platform, difficulty, tags = [] } = Astro.props;
const formatted = date.toISOString().slice(0, 10);
---

<a
  href={href}
  class="group block rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 transition-all hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:shadow-lg"
>
  <div class="flex items-center gap-2 text-xs">
    <time class="font-mono text-[var(--color-muted)]">{formatted}</time>
    {platform && <span class="rounded bg-[var(--color-bg-elev)] px-1.5 py-0.5 font-mono text-[var(--color-teal)]">{platform}</span>}
    {difficulty && <span class="rounded bg-[var(--color-bg-elev)] px-1.5 py-0.5 font-mono text-[var(--color-warn)]">{difficulty}</span>}
  </div>
  <h3 class="mt-2 font-mono text-lg font-semibold text-[var(--color-text-strong)] group-hover:text-[var(--color-accent)]">{title}</h3>
  <p class="mt-2 text-sm text-[var(--color-text)]">{description}</p>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((t) => (
        <span class="rounded border border-[var(--color-border)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--color-muted)]">#{t}</span>
      ))}
    </div>
  )}
</a>
