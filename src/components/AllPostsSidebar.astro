---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  collection: "writeups" | "projects";
  currentId: string;
  title?: string;
}
const { collection, currentId, title = "All posts" } = Astro.props;

const entries = await getCollection(collection, (e) => !e.data.draft && e.id !== currentId);
entries.sort((a, b) => +b.data.date - +a.data.date);

const basePath = collection === "writeups" ? "/writeups" : "/projects";
---

{entries.length > 0 && (
  <aside class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4">
    <h2 class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-[var(--color-muted)]">
      <span class="text-[var(--color-teal)]">$</span> ls {collection}/
    </h2>
    <ul class="flex flex-col gap-2.5">
      {entries.map((e: CollectionEntry<"writeups" | "projects">) => (
        <li>
          <a
            href={`${basePath}/${e.id}/`}
            class="group block rounded px-2 py-1.5 transition-colors hover:bg-[var(--color-bg-elev)]"
          >
            <span class="block font-mono text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)]">{e.data.title}</span>
            <span class="mt-0.5 block font-mono text-[10px] text-[var(--color-muted)]">{e.data.date.toISOString().slice(0, 10)}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
