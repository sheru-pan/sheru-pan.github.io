---
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  collection: "writeups" | "projects";
  currentId: string;
  series?: string;
}
const { collection, currentId, series } = Astro.props;

const basePath = collection === "writeups" ? "/writeups" : "/projects";

const pool = await getCollection(collection, (e) => !e.data.draft);

// Series mode: show every part of THIS series in order (0 → N), current highlighted.
// Otherwise: show other recent posts.
const inSeries = Boolean(series);
const entries = inSeries
  ? pool
      .filter((e) => e.data.series === series)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : pool
      .filter((e) => e.id !== currentId)
      .sort((a, b) => +b.data.date - +a.data.date);

const heading = inSeries ? series! : `ls ${collection}/`;

function concept(title: string): string {
  const c = title.indexOf(": ");
  if (c >= 0) return title.slice(c + 2);
  const d = title.indexOf(" — ");
  if (d >= 0) return title.slice(d + 3);
  return title;
}
---

{entries.length > 0 && (
  <aside class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4">
    <h2 class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-[var(--color-muted)]">
      <span class="text-[var(--color-accent)]">$</span> {heading}
    </h2>
    <ol class="flex max-h-[70vh] flex-col gap-1 overflow-y-auto pr-1">
      {entries.map((e: CollectionEntry<"writeups" | "projects">) => {
        const active = e.id === currentId;
        return (
          <li>
            <a
              href={`${basePath}/${e.id}/`}
              aria-current={active ? "page" : undefined}
              class={`group flex items-start gap-2 rounded px-2 py-1.5 transition-colors ${
                active
                  ? "bg-[var(--color-bg-elev)] ring-1 ring-[var(--color-accent)]"
                  : "hover:bg-[var(--color-bg-elev)]"
              }`}
            >
              {inSeries && (e as CollectionEntry<"writeups">).data.seriesLabel && (
                <span class={`shrink-0 font-mono text-[11px] font-semibold ${active ? "text-[var(--color-accent)]" : "text-[var(--color-muted)] group-hover:text-[var(--color-accent)]"}`}>
                  {(e as CollectionEntry<"writeups">).data.seriesLabel}
                </span>
              )}
              <span class="min-w-0">
                <span class={`block truncate font-mono text-xs ${active ? "text-[var(--color-text-strong)]" : "text-[var(--color-text)] group-hover:text-[var(--color-accent)]"}`}>
                  {inSeries ? concept(e.data.title) : e.data.title}
                </span>
                {!inSeries && (
                  <span class="mt-0.5 block font-mono text-[10px] text-[var(--color-muted)]">
                    {e.data.date.toISOString().slice(0, 10)}
                  </span>
                )}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </aside>
)}
